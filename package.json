{
  "name": "openaster",
  "version": "0.2.1",
  "private": true,
  "description": "An open, local-first agent workspace",
  "type": "module",
  "main": "desktop/main.mjs",
  "author": "OpenAster contributors",
  "homepage": "https://github.com/yanghaitao1995/OpenAster",
  "packageManager": "pnpm@11.25.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.mjs",
    "dev": "node --watch server/index.mjs",
    "backup": "node scripts/backup.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs desktop/*.test.mjs mobile/*.test.mjs",
    "test:e2e": "playwright test",
    "desktop": "electron desktop/main.mjs",
    "desktop:pack": "node scripts/build.mjs && electron-builder --config desktop/electron-builder.json --dir",
    "desktop:dist": "node scripts/build.mjs && electron-builder --config desktop/electron-builder.json --publish never",
    "mobile:prepare": "node mobile/prepare.mjs",
    "mobile:android": "node mobile/native.mjs android",
    "mobile:ios": "node mobile/native.mjs ios",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "source:pack": "node scripts/package-source.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@playwright/test": "1.64.1",
    "electron": "45.0.0",
    "electron-builder": "26.18.0"
  }
}
